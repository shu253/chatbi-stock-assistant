# Required: Alibaba Cloud DashScope API key
DASHSCOPE_API_KEY=

# Required only when downloading fresh data from Tushare
TUSHARE_TOKEN=

# Optional web-search enhancement. Keep disabled unless Node.js and npx are installed.
CHATBI_ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# Optional overrides
CHATBI_MODEL=qwen-turbo
CHATBI_DB_PATH=data/stock.db
CHATBI_RUNTIME_DIR=runtime/images
CHATBI_LOG_LEVEL=INFO

